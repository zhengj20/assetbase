# 复制为 backend/.env 后按需修改。生产环境务必替换为强随机值。

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-db-password
DB_NAME=guding

# JWT（生产环境请用强随机字符串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_HOURS=8

# 服务
HOST=0.0.0.0
PORT=5200
WORKERS=4

# 连接池
POOL_SIZE=20
MAX_OVERFLOW=40
